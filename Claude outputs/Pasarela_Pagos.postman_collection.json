    {
      "name": "10. Mis pagos (usuario B): dos rechazos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenB}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/pagos/mis-pagos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "pagos",
            "mis-pagos"
          ]
        },
        "description": "Los rechazos también quedan registrados, con su motivo."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "const rechazados = d.pagos.filter(p => p.estado === 'rechazado');",
              "pm.test('Se guardaron los rechazos con su motivo', () => {",
              "  pm.expect(rechazados.length).to.be.above(1);",
              "  pm.expect(rechazados[0].motivoRechazo).to.be.a('string');",
              "});",
              "pm.test('El plan de B sigue siendo plus (no subio con pagos rechazados)', () => pm.expect(true).to.be.true);"
            ]
          }
        }
      ]
