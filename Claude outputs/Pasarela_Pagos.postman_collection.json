          "host": [
            "{{base_url}}"
          ],
          "path": [
            "pagos"
          ]
        },
        "description": "Tarjeta de prueba terminada en 0002: siempre se rechaza.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"numeroTarjeta\": \"4000000000000002\",\n    \"titular\": \"Matias Pano\",\n    \"vencimiento\": \"12/28\",\n    \"cvv\": \"123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
