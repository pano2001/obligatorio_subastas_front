{
  "info": {
    "name": "Pasarela de pago simulada — Obligatorio Subastas",
    "description": "Pruebas del endpoint POST /v1/pagos y GET /v1/pagos/mis-pagos.\n\nAntes de correr: cargá base_url y las credenciales de DOS usuarios con plan plus (userA/passA y userB/passB). Corré la colección con el Runner, en orden.\n\nTarjetas de prueba: 4111111111111111 se aprueba; 4000000000000002 se rechaza por fondos insuficientes. No corresponden a tarjetas reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login usuario plus A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Guarda el token del usuario A y verifica que tenga plan plus.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{userA}}\",\n    \"password\": \"{{passA}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.collectionVariables.set('tokenA', d.token);",
              "pm.collectionVariables.set('planA', d.usuario.plan);",
              "pm.test('El usuario A es plus (si no, usá otro usuario)', () => pm.expect(d.usuario.plan).to.eql('plus'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Pago aprobado (Visa de prueba)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/pagos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "pagos"
          ]
        },
        "description": "Pago que debe aprobarse. Verifica el token nuevo, el plan y que no se guarden datos sensibles.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"numeroTarjeta\": \"4111111111111111\",\n    \"titular\": \"Matias Pano\",\n    \"vencimiento\": \"12/28\",\n    \"cvv\": \"123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const d = pm.response.json();",
              "pm.test('Devuelve token nuevo', () => pm.expect(d.token).to.be.a('string'));",
              "pm.test('El usuario quedó premium', () => pm.expect(d.usuario.plan).to.eql('premium'));",
              "pm.test('El pago quedó aprobado', () => pm.expect(d.pago.estado).to.eql('aprobado'));",
              "pm.test('Solo guarda los ultimos 4', () => pm.expect(d.pago.ultimosCuatro).to.eql('1111'));",
              "pm.test('No guarda el numero completo ni el CVV', () => {",
              "  const txt = JSON.stringify(d.pago);",
              "  pm.expect(txt).to.not.include('4111111111111111');",
              "  pm.expect(txt).to.not.include('cvv');",
              "});",
              "pm.test('Monto 20 USD', () => { pm.expect(d.pago.monto).to.eql(20); pm.expect(d.pago.moneda).to.eql('USD'); });",
              "pm.collectionVariables.set('tokenA_nuevo', d.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Mis pagos (usuario A)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA_nuevo}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/pagos/mis-pagos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "pagos",
            "mis-pagos"
          ]
        },
        "description": "Historial de pagos del usuario A."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('Hay al menos un pago', () => pm.expect(d.pagos.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Pagar de nuevo siendo premium (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA_nuevo}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/pagos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "pagos"
          ]
        },
        "description": "No se puede pagar dos veces el mismo plan.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"numeroTarjeta\": \"4111111111111111\",\n    \"titular\": \"Matias Pano\",\n    \"vencimiento\": \"12/28\",\n    \"cvv\": \"123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('Mensaje claro', () => pm.expect(pm.response.json().message).to.include('premium'));"
            ]
          }
        }
      ]
    },
